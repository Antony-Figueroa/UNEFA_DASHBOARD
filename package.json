    "@react-pdf/renderer": "^4.3.2",
    "@supabase/supabase-js": "^2.90.1",
    "@tailwindcss/cli": "^4.1.18",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "@vercel/analytics": "^1.6.1",
    "apexcharts": "^4.1.0",
    "axios": "^1.13.2",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "driver.js": "^1.4.0",
    "exceljs": "^3.4.0",
    "express": "^4.22.1",
    "file-saver": "^2.0.5",
