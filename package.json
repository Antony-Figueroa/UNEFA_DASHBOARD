{
  "name": "unefa-dashboard",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host",
    "start": "vite preview --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docker:start": "node -e \"const { platform } = require('os'); const { spawn } = require('child_process'); const cmd = platform() === 'win32' ? 'setup-docker.bat' : './setup-docker.sh'; spawn(cmd, { stdio: 'inherit', shell: true });\"",
    "electron:dev": "concurrently -k \"vite --host --port 5173\" \"tsx electron/main.mjs\"",
    "electron:dev:backend": "concurrently -k \"vite --host --port 5173\" \"cd backend && npx tsx src/server-offline.ts\" \"tsx electron/main.mjs\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@formkit/drag-and-drop": "^0.6.0",
