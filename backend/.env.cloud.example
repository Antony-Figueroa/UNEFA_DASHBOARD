# Supabase Configuration - CLOUD
# ⚠️  DO NOT commit real values. Copy to .env.cloud and fill in locally.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_JWT
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

# Local Supabase (for dump-prod-to-local.ts)
LOCAL_SUPABASE_URL=http://127.0.0.1:54321
LOCAL_SUPABASE_SERVICE_ROLE_KEY=YOUR_LOCAL_SERVICE_ROLE_JWT
