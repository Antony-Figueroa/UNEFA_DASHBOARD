// ================================================================================
// UNEFA Dashboard - Prisma Schema
// ================================================================================
// ORIGEN: Supabase PostgreSQL (producción)
// PROPÓSITO: Type generation, documentación, y base para versión offline con PGlite
// TABLAS: 54 modelos (refleja exactamente el schema de producción)
// ================================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================================================================================
// TABLA: t_persons (Superentidad de datos personales)
// ================================================================================
model TPerson {
  person_id       Int       @id @default(autoincrement())
  ci              String
  first_name      String
  middle_name     String?
  last_name       String
  second_last_name String?
  email           String
  phone           String?
  gender          String?
  birthdate       DateTime?
  address         String?
  marital_status  String?
  status          Int       @default(1)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now())

  // Relaciones
  users               TUser[]                   @relation("PersonUser")
  students            TStudent[]                @relation("PersonStudent")
  tutors              TTutor[]                  @relation("PersonTutor")
  institutionManagers TInstitutionManager[]     @relation("PersonManager")

  @@map("t_persons")
}

// ================================================================================
// TABLA: t_user (Usuarios del sistema)
// ================================================================================
model TUser {
  USER_ID              Int       @id @default(autoincrement())
  USER                 String
  USER_CI              String
  NAME                 String?
  SECOND_NAME          String?
  SURNAME              String?
  SECOND_SURNAME       String?
  EMAIL                String?
  PHONE_NUMBER         String?
  CREATION_DATE        DateTime
  LOGIN                Int
  TERMS_CONDITIONS     String
  STATUS_SESSION       Int
  STATUS               Int       @default(1)
  FAILED_ATTEMPTS      Int       @default(0)
  LOCK_DATE            DateTime?
  FORCE_PASSWORD_CHANGE Boolean  @default(false)
  LAST_LOGIN           DateTime?
  person_id            Int?

  // Relaciones
  authLogs            TAuthLog[]
  sessions            TSession[]
  sessionAttempts     TSessionAttempt[]
  notifications       TNotification[]
  recoveryTokens      TRecoveryToken[]
  passwordHistories   TPasswordHistory[]
  userKeys            TUserKey[]
  userQuestions       TUserQuestion[]
  userRoles           TUserRole[]
  userTheme           TUserTheme?
  students            TStudent[]
  tutors              TTutor[]
  backups             TBackup[]
  chatSessions        TChatSession[]
  evaluations         TEvaluation[] @relation("EvaluatorUser")
  registeredEvaluations TEvaluation[] @relation("RegisteredByUser")
  reviewedDocuments    TStudentDocument[]
  securityQuestions    TSecurityQuestion[]
  changeLogs          TChangeLog[]
  person              TPerson?  @relation("PersonUser", fields: [person_id], references: [person_id])

  @@unique([USER_CI])
  @@map("t_user")
}

// ================================================================================
// TABLA: t_students (Estudiantes)
// ================================================================================
model TStudent {
  STUDENTS_ID         Int       @id @default(autoincrement())
  STUDENTS_CI         String?
  NAME                String?
  SECOND_NAME         String?
  SURNAME             String?
  SECOND_SURNAME      String?
  GENDER              String?
  BIRTHDATE           DateTime?
  CONTACT_PHONE       String?
  EMAIL               String?
  ADDRESS             String?
  MARITAL_STATUS      String?
  STUDENT_TYPE        String
  MILITARY_RANK       String?
  EMPLOYMENT          String
  STATUS              Int       @default(1)
  REGISTRATION_DATE   DateTime?
  USER_ID             Int?
  person_id           Int

  // Relaciones
  user                TUser?    @relation(fields: [USER_ID], references: [USER_ID])
  person              TPerson   @relation("PersonStudent", fields: [person_id], references: [person_id])
  professionalPractices TProfessionalPractice[]
  activityLogs          TActivityLog[]
  studentDocuments      TStudentDocument[]
  studentRequests       TStudentRequest[]

  @@unique([STUDENTS_CI])
  @@map("t_students")
}

// ================================================================================
// TABLA: t_career (Carreras)
// ================================================================================
model TCareer {
  CAREER_ID           Int       @id @default(autoincrement())
  CAREER_NAME         String
  CAREER_CODE         String
  MINIMUM_GRADE       Float
  CAREER_ABBREVIATION String
  SEMESTER            String?
  CREATION_DATE       DateTime
  MODIF_USER_ID       Int
  MODIF_USER_DATE     DateTime
  ELIM_USER_ID        Int
  ELIM_USER_DATE      DateTime
  REST_USER_ID        Int
  REST_USER_DATE      DateTime
  STATUS              Int       @default(1)
  CAREER_TYPE         String    @default("LARGA")
  AUTO_PRE_ENROLL     Boolean   @default(true)

  // Relaciones
  tutors              TTutorCareer[]
  institutionCareers  TInstitutionCareer[]
  careerInternshipTypes TCareerInternshipType[]
  professionalPractices TProfessionalPractice[]

  @@unique([CAREER_CODE])
  @@map("t_career")
}

// ================================================================================
// TABLA: t_tutors (Tutores académicos)
// ================================================================================
model TTutor {
  TUTOR_ID            Int       @id @default(autoincrement())
  TUTOR_CI            String?
  NAME                String?
  SECOND_NAME         String?
  SURNAME             String?
  SECOND_SURNAME      String?
  CONTACT_PHONE       String?
  GENDER              String?
  EMAIL               String?
  PROFESSION          String
  CONDITION           String
  DEDICATION          String
  CATEGORY            String
  TITULO              String?
  CREATION_DATE       DateTime
  STATUS              Int       @default(1)
  USER_ID             Int?
  person_id           Int

  // Relaciones
  user                TUser?    @relation(fields: [USER_ID], references: [USER_ID])
  person              TPerson   @relation("PersonTutor", fields: [person_id], references: [person_id])
  tutorCareers        TTutorCareer[]
  practiceVisits      TPracticeVisit[]
  professionalPracticeTutors TProfessionalPracticeTutor[]
  legacyVisits          TVisit[]

  @@unique([TUTOR_CI])
  @@map("t_tutors")
}

// ================================================================================
// TABLA: t_tutor_career (Relación Tutor-Carrera)
// ================================================================================
model TTutorCareer {
  TUTOR_CAREER_ID     BigInt    @id @default(autoincrement())
  created_at          DateTime  @default(now())
  TUTOR_ID            Int
  CAREER_ID           Int

  // Relaciones
  tutor               TTutor    @relation(fields: [TUTOR_ID], references: [TUTOR_ID])
  career              TCareer   @relation(fields: [CAREER_ID], references: [CAREER_ID])

  @@map("t_tutor_career")
}

// ================================================================================
// TABLA: t_institution (Instituciones/empresas)
// ================================================================================
model TInstitution {
  INSTITUTION_ID      Int       @id @default(autoincrement())
  INSTITUTION_NAME    String
  INSTITUTION_ADDRESS String
  INSTITUTION_CONTACT String
  PRACTICE_TYPE       String
  REGION              String
  NUCLEUS             String
  EXTENSION           String
  CREATION_DATE       DateTime
  INSTITUTION_TYPE    String
  STATUS              Int       @default(1)
  RIF                 String
  INSTITUTION_CODE    String

  // Relaciones
  institutionManagers TInstitutionManager[]
  institutionCareers  TInstitutionCareer[]
  institutionInternshipTypes TInstitutionInternshipType[]
  professionalPractices TProfessionalPractice[]
  institutionManagerInstitutions TInstitutionManagerInstitution[]

  @@unique([INSTITUTION_CODE])
  @@index([RIF])
  @@map("t_institution")
}

// ================================================================================
// TABLA: t_institution_manager (Responsables de institución)
// ================================================================================
model TInstitutionManager {
  MANAGER_ID          Int       @id @default(autoincrement())
  MANAGER_CI          String?
  NAME                String?
  SECOND_NAME         String?
  SURNAME             String?
  SECOND_SURNAME      String?
  CONTACT_PHONE       String?
  EMAIL               String?
  CREATION_DATE       DateTime
  STATUS              Int       @default(1)
  INSTITUTION_ID      Int?
  cargo               String?
  person_id           Int

  // Relaciones
  institution         TInstitution? @relation(fields: [INSTITUTION_ID], references: [INSTITUTION_ID])
  person              TPerson   @relation("PersonManager", fields: [person_id], references: [person_id])
  professionalPractices TProfessionalPractice[]
  managerInstitutions TInstitutionManagerInstitution[]

  @@unique([MANAGER_CI])
  @@map("t_institution_manager")
}

// ================================================================================
// TABLA: t_institution_manager_institution (Relación Manager-Institución N:M)
// ================================================================================
model TInstitutionManagerInstitution {
  INSTITUTION_MANAGER_INSTITUTION_ID BigInt    @id @default(autoincrement())
  created_at                    DateTime  @default(now())
  MANAGER_ID                    Int
  INSTITUTION_ID                Int
  cargo                         String?

  // Relaciones
  manager                       TInstitutionManager @relation(fields: [MANAGER_ID], references: [MANAGER_ID])
  institution                   TInstitution        @relation(fields: [INSTITUTION_ID], references: [INSTITUTION_ID])

  @@map("t_institution_manager_institution")
}

// ================================================================================
// TABLA: t_institution_career (Relación Institución-Carrera N:M)
// ================================================================================
model TInstitutionCareer {
  INSTITUTION_CAREER_ID BigInt    @id @default(autoincrement())
  created_at           DateTime  @default(now())
  INSTITUTION_ID       Int
  CAREER_ID           Int

  // Relaciones
  institution          TInstitution @relation(fields: [INSTITUTION_ID], references: [INSTITUTION_ID])
  career               TCareer    @relation(fields: [CAREER_ID], references: [CAREER_ID])

  @@map("t_institution_career")
}

// ================================================================================
// TABLA: t_institution_internship_type (Relación Institución-Tipo práctica N:M)
// ================================================================================
model TInstitutionInternshipType {
  INSTITUTION_INTERNSHIP_TYPE_ID BigInt    @id @default(autoincrement())
  created_at                    DateTime  @default(now())
  INSTITUTION_ID                Int
  INTERNSHIP_TYPE_ID           Int

  // Relaciones
  institution        TInstitution   @relation(fields: [INSTITUTION_ID], references: [INSTITUTION_ID])
  internshipType     TInternshipType @relation(fields: [INTERNSHIP_TYPE_ID], references: [INTERNSHIP_TYPE_ID])

  @@map("t_institution_internship_type")
}

// ================================================================================
// TABLA: t_internship_type (Tipos de prácticas profesionales)
// ================================================================================
model TInternshipType {
  INTERNSHIP_TYPE_ID  Int       @id @default(autoincrement())
  NAME                String
  PRIORITY            Int       @default(1)
  CREATION_DATE       DateTime
  STATUS              Int       @default(1)

  // Relaciones
  careerInternshipTypes TCareerInternshipType[]
  institutionInternshipTypes TInstitutionInternshipType[]
  professionalPractices TProfessionalPractice[]

  @@map("t_internship_type")
}

// ================================================================================
// TABLA: t_career_internship_type (Relación Carrera-Tipo práctica)
// ================================================================================
model TCareerInternshipType {
  ID_CAREER_INTERNSHIP_TYPE_ID Int       @id @default(autoincrement())
  CAREER_ID            Int
  INTERNSHIP_TYPE_ID   Int

  // Relaciones
  career            TCareer         @relation(fields: [CAREER_ID], references: [CAREER_ID])
  internshipType    TInternshipType @relation(fields: [INTERNSHIP_TYPE_ID], references: [INTERNSHIP_TYPE_ID])

  @@map("t_career_internship_type")
}

// ================================================================================
// TABLA: t_internships_period (Períodos académicos de pasantías)
// ================================================================================
model TInternshipsPeriod {
  PERIOD_ID            Int       @id @default(autoincrement())
  START_DATE           DateTime
  END_DATE             DateTime
  CREATION_DATE       DateTime
  DESCRIPTION         String
  PERIOD_STATUS       String
  STATUS              Int       @default(1)
  T_INTERNSHIPS_CODE  String

  // Relaciones
  professionalPractices TProfessionalPractice[]

  @@map("t_internships_period")
}

// ================================================================================
// TABLA: t_professional_practices (Prácticas profesionales - tabla central)
// ================================================================================
model TProfessionalPractice {
  PROFESSIONAL_PRACTICE_ID Int       @id @default(autoincrement())
  START_DATE              DateTime
  END_DATE                DateTime
  REPORT_TITLE           String
  REGISTRATION_DATE      DateTime
  CREATION_DATE          DateTime
  GRADE                  Float
  TRANSFER                Int       @default(0)
  TOUR                   String
  PERIOD_ID              Int
  INSTITUTION_ID         Int?
  STUDENTS_ID            Int
  STATUS                 Int       @default(1)
  MANAGER_ID             Int?
  OBSERVATION            String
  ENROLLMENT            String
  INTERNSHIP_STATUS     Int       @default(1)
  INTERNSHIP_TYPE_ID    Int
  PRACTICES_STATUS      Int       @default(1)
  EVALUATION_STATUS     String?   @default("pending")
  SEMESTER              String?
  SECTION               String?
  REGIME                String?
  CAREER_ID             Int?

  // Relaciones
  period               TInternshipsPeriod     @relation(fields: [PERIOD_ID], references: [PERIOD_ID])
  institution           TInstitution?          @relation(fields: [INSTITUTION_ID], references: [INSTITUTION_ID])
  student              TStudent             @relation(fields: [STUDENTS_ID], references: [STUDENTS_ID])
  manager              TInstitutionManager?   @relation(fields: [MANAGER_ID], references: [MANAGER_ID])
  internshipType       TInternshipType     @relation(fields: [INTERNSHIP_TYPE_ID], references: [INTERNSHIP_TYPE_ID])
  career               TCareer?             @relation(fields: [CAREER_ID], references: [CAREER_ID])

  // Relaciones adicionales
  activityLogs         TActivityLog[]
  practiceVisits       TPracticeVisit[]
  evaluations         TEvaluation[]
  professionalPracticeTutors TProfessionalPracticeTutor[]
  legacyVisits          TVisit[]

  @@index([STUDENTS_ID])
  @@index([INSTITUTION_ID])
  @@index([STATUS])
  @@map("t_professional_practices")
}

// ================================================================================
// TABLA: t_professional_practices_tutor (Relación Práctica-Tutor)
// ================================================================================
model TProfessionalPracticeTutor {
  PROFESSIONAL_PRACTICES_TUTOR_ID Int       @id @default(autoincrement())
  TUTOR_ID                       Int
  PROFESSIONAL_PRACTICE_ID       Int
  TUTOR_TYPE                    String

  // Relaciones
  tutor                 TTutor              @relation(fields: [TUTOR_ID], references: [TUTOR_ID])
  professionalPractice TProfessionalPractice @relation(fields: [PROFESSIONAL_PRACTICE_ID], references: [PROFESSIONAL_PRACTICE_ID])

  @@index([PROFESSIONAL_PRACTICE_ID])
  @@map("t_professional_practices_tutor")
}

// ================================================================================
// TABLA: t_activity_logs (Bitácora de actividades del estudiante)
// ================================================================================
model TActivityLog {
  ACTIVITY_LOG_ID       Int       @id @default(autoincrement())
  PROFESSIONAL_PRACTICE_ID Int
  STUDENT_ID           Int
  ACTIVITY_DATE        DateTime
  WEEK_NUMBER          Int?
  HOURS_WORKED         Float     @default(0)
  ACTIVITY_TYPE        String    @default("DIARIA")
  ACTIVITY_DESCRIPTION String
  TASKS_COMPLETED      String?
  CHALLENGES          String?
  LEARNINGS           String?
  SUPERVISOR_COMMENTS String?
  SUPERVISOR_APPROVED Boolean   @default(false)
  SUPERVISOR_ID       Int?
  APPROVED_AT         DateTime?
  STATUS              Int       @default(1)
  CREATED_AT          DateTime  @default(now())
  UPDATED_AT          DateTime  @default(now())
  CREATED_BY          Int?

  // Relaciones
  professionalPractice TProfessionalPractice @relation(fields: [PROFESSIONAL_PRACTICE_ID], references: [PROFESSIONAL_PRACTICE_ID])
  student              TStudent       @relation(fields: [STUDENT_ID], references: [STUDENTS_ID])

  @@map("t_activity_logs")
}

// ================================================================================
// TABLA: t_practice_visits (Visitas de seguimiento a pasantías)
// ================================================================================
model TPracticeVisit {
  VISIT_ID              Int       @id @default(autoincrement())
  PROFESSIONAL_PRACTICE_ID Int
  TUTOR_ID             Int
  VISIT_DATE           DateTime  @default(now())
  VISIT_TYPE           String    @default("PRESENCIAL")
  HOURS_WORKED         Float     @default(0)
  ACTIVITIES_PERFORMED String?
  OBSERVATIONS         String?
  RECOMMENDATIONS     String?
  STATUS               Int       @default(1)
  CREATED_AT           DateTime  @default(now())
  UPDATED_AT           DateTime  @default(now())
  CREATED_BY           Int?
  VISIT_CASE           String    @default("SEGUIMIENTO_REGULAR")

  // Relaciones
  professionalPractice TProfessionalPractice @relation(fields: [PROFESSIONAL_PRACTICE_ID], references: [PROFESSIONAL_PRACTICE_ID])
  tutor                TTutor          @relation(fields: [TUTOR_ID], references: [TUTOR_ID])

  @@index([PROFESSIONAL_PRACTICE_ID])
  @@index([TUTOR_ID])
  @@index([VISIT_DATE])
  @@index([STATUS])
  @@index([VISIT_CASE])
  @@map("t_practice_visits")
}

// ================================================================================
// TABLA: t_evaluation (Evaluaciones de prácticas)
// ================================================================================
model TEvaluation {
  EVALUATION_ID         Int       @id @default(autoincrement())
  PROFESSIONAL_PRACTICE_ID Int
  EVALUATOR_TYPE        String
  EVALUATOR_ID          Int?
  EVALUATOR_NAME        String
  EVALUATOR_CI         String?
  TOTAL_SCORE          Float
  OBSERVATIONS         String?
  EVALUATION_DATE      DateTime  @default(now())
  REGISTERED_BY        Int?
  STATUS               Int       @default(1)

  // Relaciones
  professionalPractice  TProfessionalPractice @relation(fields: [PROFESSIONAL_PRACTICE_ID], references: [PROFESSIONAL_PRACTICE_ID])
  evaluator             TUser?     @relation("EvaluatorUser", fields: [EVALUATOR_ID], references: [USER_ID])
  registeredBy         TUser?     @relation("RegisteredByUser", fields: [REGISTERED_BY], references: [USER_ID])
  evaluationDetails     TEvaluationDetail[]

  @@index([PROFESSIONAL_PRACTICE_ID])
  @@index([EVALUATOR_TYPE])
  @@map("t_evaluation")
}

// ================================================================================
// TABLA: t_evaluation_criteria (Criterios de evaluación)
// ================================================================================
model TEvaluationCriteria {
  CRITERIA_ID        Int       @id @default(autoincrement())
  ITEM_NUMBER        Int
  DESCRIPTION       String
  EVALUATOR_TYPE    String
  STATUS            Int       @default(1)

  evaluationDetails TEvaluationDetail[]

  @@index([EVALUATOR_TYPE])
  @@map("t_evaluation_criteria")
}

// ================================================================================
// TABLA: t_evaluation_detail (Detalle de puntajes por criterio)
// ================================================================================
model TEvaluationDetail {
  DETAIL_ID         Int       @id @default(autoincrement())
  EVALUATION_ID     Int
  CRITERIA_ID       Int?
  ITEM_NUMBER      Int
  SCORE            Int
  STATUS           Int       @default(1)

  // Relaciones
  evaluation        TEvaluation       @relation(fields: [EVALUATION_ID], references: [EVALUATION_ID])
  criteria          TEvaluationCriteria? @relation(fields: [CRITERIA_ID], references: [CRITERIA_ID])

  @@index([EVALUATION_ID])
  @@map("t_evaluation_detail")
}

// ================================================================================
// TABLA: t_list (Listas dinámicas del sistema)
// ================================================================================
model TList {
  LIST_ID             Int       @id @default(autoincrement())
  NAME                String
  CREATION_DATE       DateTime
  MODIF_USER_ID       Int
  MODIF_USER_DATE     DateTime
  ELIM_USER_ID        Int
  ELIM_USER_DATE      DateTime
  REST_USER_ID        Int
  REST_USER_DATE      DateTime
  STATUS              Int       @default(1)

  // Relaciones
  valueLists         TValueList[]

  @@map("t_list")
}

// ================================================================================
// TABLA: t_value_list (Valores de listas dinámicas)
// ================================================================================
model TValueList {
  VALUE_LIST_ID      Int       @id @default(autoincrement())
  NAME               String
  ABBREVIATION       String?
  LIST_ID            Int
  CREATION_DATE      DateTime
  MODIF_USER_ID      Int
  MODIF_USER_DATE    DateTime
  ELIM_USER_ID       Int
  ELIM_USER_DATE     DateTime
  REST_USER_ID       Int
  REST_USER_DATE     DateTime
  STATUS             Int       @default(1)

  // Relaciones
  list               TList     @relation(fields: [LIST_ID], references: [LIST_ID])

  @@map("t_value_list")
}

// ================================================================================
// TABLA: t_notifications (Notificaciones a usuarios)
// ================================================================================
model TNotification {
  NOTIFICATION_ID     Int       @id @default(autoincrement())
  USER_ID             Int
  TYPE                String
  TITLE               String
  MESSAGE             String
  READ                Boolean   @default(false)
  READ_AT             DateTime?
  DATA                String?   // JSON string (JSONB en PostgreSQL)
  CREATED_AT          DateTime  @default(now())

  // Relaciones
  user                TUser     @relation(fields: [USER_ID], references: [USER_ID])

  @@index([USER_ID])
  @@index([USER_ID, READ])
  @@index([CREATED_AT])
  @@map("t_notifications")
}

// ================================================================================
// TABLA: t_student_documents (Documentos de estudiantes)
// ================================================================================
model TStudentDocument {
  DOCUMENT_ID         Int       @id @default(autoincrement())
  STUDENT_ID          Int
  DOCUMENT_TYPE       String
  TITLE               String
  DESCRIPTION         String?
  FILE_NAME           String
  FILE_PATH           String
  FILE_SIZE           Int?
  FILE_TYPE           String?
  STATUS              String    @default("pending")
  REJECTION_REASON    String?
  UPLOADED_AT        DateTime  @default(now())
  REVIEWED_AT        DateTime?
  REVIEWED_BY        Int?
  CREATION_DATE      DateTime  @default(now())
  MODIF_USER_ID      Int       @default(0)
  MODIF_USER_DATE    DateTime  @default(now())
  STATUS_TABLE       Int       @default(1)

  // Relaciones
  student             TStudent  @relation(fields: [STUDENT_ID], references: [STUDENTS_ID])
  reviewer            TUser?    @relation(fields: [REVIEWED_BY], references: [USER_ID])

  @@index([STUDENT_ID])
  @@index([DOCUMENT_TYPE])
  @@index([STATUS])
  @@map("t_student_documents")
}

// ================================================================================
// TABLA: t_student_requests (Solicitudes de estudiantes)
// ================================================================================
model TStudentRequest {
  REQUEST_ID            Int       @id @default(autoincrement())
  STUDENT_ID            Int
  REQUEST_TYPE_ID       Int
  SUBJECT               String
  DESCRIPTION          String
  STATUS               String    @default("pending")
  RESPONSE             String?
  PROCESSED_BY         Int?
  PROCESSED_AT         DateTime?
  CREATION_DATE        DateTime  @default(now())
  MODIF_USER_ID        Int       @default(0)
  MODIF_USER_DATE      DateTime  @default(now())
  ELIM_USER_ID         Int       @default(0)
  ELIM_USER_DATE       DateTime  @default(now())
  REST_USER_ID         Int       @default(0)
  REST_USER_DATE       DateTime  @default(now())
  STATUS_TABLE         Int       @default(1)
  REASSIGNMENT_DATA    String?   // JSON string (JSONB en PostgreSQL)
  IS_REASSIGNMENT     Int       @default(0)
  PREVIOUS_TUTOR_ID   Int?
  PREVIOUS_INSTITUTION_ID Int?
  PREVIOUS_CAREER_ID  Int?

  // Relaciones
  student              TStudent  @relation(fields: [STUDENT_ID], references: [STUDENTS_ID])
  requestType         TRequestType @relation(fields: [REQUEST_TYPE_ID], references: [REQUEST_TYPE_ID])

  @@index([STUDENT_ID])
  @@index([STATUS])
  @@index([REQUEST_TYPE_ID])
  @@index([IS_REASSIGNMENT])
  @@map("t_student_requests")
}

// ================================================================================
// TABLA: t_request_types (Tipos de solicitudes)
// ================================================================================
model TRequestType {
  REQUEST_TYPE_ID    Int       @id @default(autoincrement())
  NAME              String
  DESCRIPTION       String?
  IS_ACTIVE         Int       @default(1)
  CREATION_DATE     DateTime  @default(now())
  MODIF_USER_ID     Int       @default(0)
  MODIF_USER_DATE   DateTime  @default(now())
  ELIM_USER_ID      Int       @default(0)
  ELIM_USER_DATE    DateTime  @default(now())
  REST_USER_ID      Int       @default(0)
  REST_USER_DATE    DateTime  @default(now())
  STATUS            Int       @default(1)
  IS_REASSIGNMENT  Int       @default(0)
  CATEGORY         String    @default("GENERAL")

  // Relaciones
  studentRequests   TStudentRequest[]

  @@index([CATEGORY])
  @@map("t_request_types")
}

// ================================================================================
// TABLA: t_auth_log (Log de autenticación)
// ================================================================================
model TAuthLog {
  ID              Int       @id @default(autoincrement())
  USER_ID         Int?
  USER_CI         String?
  ACTION          String
  IP_ADDRESS      String?
  USER_AGENT      String?
  DETAILS         String?
  CREATED_AT      DateTime  @default(now())

  // Relaciones
  user            TUser?    @relation(fields: [USER_ID], references: [USER_ID])

  @@map("t_auth_log")
}

// ================================================================================
// TABLA: t_session (Sesiones de usuario)
// ================================================================================
model TSession {
  SESSION_ID        Int
  USER_ID           Int
  LOGIN_TIME        DateTime
  MODIF_USER_ID    Int
  MODIF_USER_DATE  DateTime
  ELIM_USER_ID     Int
  ELIM_USER_DATE   DateTime
  REST_USER_ID     Int
  REST_USER_DATE   DateTime
  STATUS           Int       @default(1)

  // Relaciones
  user              TUser     @relation(fields: [USER_ID], references: [USER_ID])
  sessionHistories  TSessionHistory[]

