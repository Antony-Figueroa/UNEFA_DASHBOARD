# Variables de entorno para Vercel
# Configurar estas variables en: Vercel Dashboard > Project Settings > Environment Variables

# Supabase (requeridas)
SUPABASE_URL=https://rgvnwslyvixviypgegra.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# JWT
JWT_SECRET=your-jwt-secret

# Entorno
NODE_ENV=production
PORT=3000

# CORS — agregar la URL del frontend
ALLOWED_ORIGINS=https://unefa-dashboard.vercel.app,http://localhost:5173

# Resend (requerido para notificaciones por email)
RESEND_API_KEY=re_xxxxxxxxx
# Opcional: personalizar el remitente (por defecto usa "SIGP UNEFA" <onboarding@resend.dev>)
# RESEND_FROM_NAME="SIGP UNEFA"
# RESEND_FROM_EMAIL=notificaciones@tudominio.com
