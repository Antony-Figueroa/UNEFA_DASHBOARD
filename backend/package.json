{
  "name": "unefa-backend",
  "version": "1.0.0",
  "description": "Backend para Proyecto-Unefa",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest --config tests/vitest.config.ts",
    "test:env": "tsx src/test-env-readonly.ts",
    "db:fix-sequences": "tsx fix-sequences.ts",
    "db:sync": "tsx sync-via-psql.ts",
    "db:seed:empty": "tsx scripts/seed-empty.ts",
    "db:seed:full": "tsx scripts/seed-full.ts",
    "db:seed:empty:cloud": "tsx scripts/seed-empty.ts --cloud",
    "db:seed:full:cloud": "tsx scripts/seed-full.ts --cloud"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^7.5.0",
    "@supabase/supabase-js": "^2.90.1",
    "@types/multer": "^2.0.0",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "groq-sdk": "^0.37.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.10",
    "prisma": "^7.5.0",
    "resend": "^6.12.4",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.7"
  }
}
